# Brain bridge env  -> /etc/default/lab-brain-bridge   (NODE: homelab)
BRAIN_API_URL=http://mainbrain-api:8000
BRAIN_API_TOKEN=            # agent token minted with the api:read scope
BRAIN_USE_DATASHEETS=1
BRAIN_DRAW=1
LAB_MQTT_HOST=orin.local
LAB_MQTT_PORT=1883
LAB_MQTT_USER=homelab
# LAB_MQTT_PASS=set-me
