# Voice env. Split across the two nodes; copy the relevant half.
# --- Orin voice service  -> /etc/default/voice-service ---
VOICE_WHISPER_MODEL=base.en
VOICE_WHISPER_DEVICE=cuda
VOICE_WHISPER_COMPUTE=float16
VOICE_PIPER_MODEL=/home/orin/piper/en_US-amy-medium.onnx
# VOICE_PIPER_CONFIG defaults to the model + ".json"
SATELLITE_URL=http://shop-pi.local:8096
VOICE_HTTP_PORT=8095
LAB_MQTT_HOST=127.0.0.1
LAB_MQTT_PORT=1883
LAB_MQTT_USER=lab
# LAB_MQTT_PASS=set-me

# --- Shop satellite  -> /etc/default/voice-satellite ---
ORIN_URL=http://orin.local:8095
WAKE_MODEL=hey jarvis
WAKE_THRESHOLD=0.5
SAT_HTTP_PORT=8096
# Blue Yeti: fixed 48 kHz device, so capture at 48 kHz and let the satellite
# resample to the 16 kHz mono the wake word + Whisper need. If the Yeti refuses
# to open as mono on your Pi, set CAPTURE_CHANNELS=2 (it downmixes to mono).
CAPTURE_RATE=48000
CAPTURE_CHANNELS=1
# Find the indices with:  python3 shop/voice_satellite.py --list-devices
# MIC_DEVICE=1        # the Yeti's input index
# SPK_DEVICE=0        # bench speaker (or the Yeti's own headphone jack)
PLAY_CMD=aplay -q {path}
