# Voice env. Split across the two nodes; copy the relevant half.
# --- Orin voice service  -> /etc/default/lab-voice ---
VOICE_WHISPER_MODEL=base.en
VOICE_WHISPER_DEVICE=cuda
VOICE_WHISPER_COMPUTE=float16
VOICE_PIPER_MODEL=/home/orin/piper/en_US-amy-medium.onnx
# VOICE_PIPER_CONFIG defaults to the model + ".json"
SATELLITE_URL=http://shop-pi.local:8096
VOICE_HTTP_PORT=8095
LAB_MQTT_HOST=127.0.0.1
LAB_MQTT_PORT=1883
LAB_MQTT_USER=lab
# LAB_MQTT_PASS=set-me

# --- Shop satellite  -> /etc/default/lab-voice-satellite ---
ORIN_URL=http://orin.local:8095
WAKE_MODEL=hey jarvis
WAKE_THRESHOLD=0.5
SAT_HTTP_PORT=8096
# MIC_DEVICE=1
# SPK_DEVICE=0
PLAY_CMD=aplay -q {path}
